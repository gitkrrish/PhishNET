{
  "name": "tracewall",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "api": "node --experimental-sqlite backend/server.mjs",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "verify:protection": "rolldown temp-audit/protection-e2e.mts --format esm --platform node -o temp-audit/.out/protection-e2e.mjs && node temp-audit/.out/protection-e2e.mjs",
    "verify:panels": "node temp-audit/.out/protection-panels.mjs",
    "verify:pages": "node temp-audit/.out/protection-render.mjs",
    "verify:effects": "node temp-audit/.out/protection-effects.mjs",
    "verify:render": "rolldown -c temp-audit/render.config.mjs && npm run verify:panels && npm run verify:pages && npm run verify:effects",
    "verify:backend": "rolldown temp-audit/protection-backend-e2e.mts --format esm --platform node -o temp-audit/.out/protection-backend-e2e.mjs && node temp-audit/.out/protection-backend-e2e.mjs",
    "api:monitoring": "node --experimental-sqlite backend/server.mjs",
    "verify:monitoring:backend": "rolldown temp-audit/monitoring-hub-backend.mts --format esm --platform node -o temp-audit/.out/monitoring-hub-backend.mjs && node temp-audit/.out/monitoring-hub-backend.mjs",
    "verify:monitoring:client": "rolldown -c temp-audit/render.config.mjs && node temp-audit/.out/monitoring-hub-client.mjs",
    "verify:monitoring:scheduler": "rolldown -c temp-audit/scheduler.config.mjs && node temp-audit/.out/monitoring-scheduler-liveness.mjs",
    "verify:monitoring": "npm run verify:monitoring:backend && npm run verify:monitoring:client",
    "verify": "npm run verify:protection && npm run verify:render"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.1144.0",
    "@aws-sdk/credential-providers": "^3.1144.0",
    "@aws-sdk/lib-dynamodb": "^3.1144.0",
    "@maptiler/sdk": "^4.1.0",
    "@tailwindcss/vite": "^4.3.3",
    "@xyflow/react": "^12.11.6",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "dotenv": "^17.4.2",
    "framer-motion": "^13.2.0",
    "lucide-react": "^1.45.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.3",
    "reactflow": "^11.11.4",
    "recharts": "^3.10.1",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "happy-dom": "^20.14.5",
    "oxlint": "^1.81.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0"
  }
}
