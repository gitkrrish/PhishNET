API_PORT=8787
IP_ANALYSIS_TIMEOUT_MS=10000
CORS_ORIGIN=http://localhost:5173
SESSION_HOURS=8
DEMO_PASSWORD=replace-this-in-development
MAX_BODY_BYTES=5242880
EMAIL_DNS_SERVERS=8.8.8.8,8.8.4.4
AZURE_DNS_SERVER=168.63.129.16
VIRUSTOTAL_API_KEY=replace-with-server-only-key
ABUSEIPDB_API_KEY=replace-with-server-only-key
OTX_API_KEY=replace-with-server-only-key
IPWHO_API_KEY=replace-with-server-only-key
IPINFO_TOKEN=replace-with-server-only-token
EMAIL_ANALYSIS_TIMEOUT_MS=5000
VITE_API_URL=/api

# Production (Vercel) only — not read by the application bundle.
#
# tracewall/vercel.json proxies /api/:path* to this origin and expands it at
# request time, so it is read from the Vercel project's environment settings
# and never baked into frontend source. Set it to the deployed PhishNet API
# origin with no trailing slash, e.g. https://phishnet-api-<suffix>.onrender.com
# It must be the Node backend in backend/server.mjs: that process owns the
# 24x7 monitoring scheduler, the SQLite store and the DynamoDB integration.
# Leaving it unset, or pointing it at a host that serves another application,
# makes every API call fail at the routing stage rather than reach the API.
#
# VITE_API_URL is the escape hatch: set it to a full backend origin (e.g.
# https://<backend>/api) to have the browser call the backend directly instead
# of through the rewrite. That requires CORS_ORIGIN on the backend to allow the
# Vercel domain.
PHISHNET_API_ORIGIN=
VITE_MAPTILER_API_KEY=replace-with-maptiler-key
VITE_MAPTILER_STYLE=streets-v2

# Response action enforcement channels
#
# Every channel is opt-in and OFF unless its enable flag is set to a truthy
# value. With no channel configured the UI offers response actions as tracked
# recommendations and pending actions only, and nothing is ever reported as
# blocked, quarantined or revoked.
#
# A configured channel changes state on an external control plane, so:
#   * the flag alone is not enough — the endpoint must also be set
#   * the action is held for an explicit analyst approval before anything is sent
#   * the action is only reported as ENFORCED · VERIFIED when the integration
#     explicitly confirms it applied the change. A 2xx alone is reported as
#     SENT · UNCONFIRMED, and the record is not treated as protected.
#
# The endpoint receives POST {action, entityType, entityId, value, performedBy}
# and should answer {applied: true} (or {confirmed: true}) once the control is
# really in place, {applied: false} if it did not act, or a non-2xx status.
# Endpoints are called from the browser, so they must be reachable from the
# analyst's network and must authorise the caller themselves.
#
# VITE_ENFORCEMENT_FIREWALL=true
# VITE_ENFORCEMENT_FIREWALL_ENDPOINT=https://firewall-api.example/enforce
# VITE_ENFORCEMENT_DNS=true
# VITE_ENFORCEMENT_DNS_ENDPOINT=https://dns-gateway.example/categories
# VITE_ENFORCEMENT_PROXY=true
# VITE_ENFORCEMENT_PROXY_ENDPOINT=https://proxy.example/denylist
# VITE_ENFORCEMENT_EDR=true
# VITE_ENFORCEMENT_EDR_ENDPOINT=https://edr.example/quarantine
# VITE_ENFORCEMENT_TRUST=true
# VITE_ENFORCEMENT_TRUST_ENDPOINT=https://trust.example/revocations
# VITE_ENFORCEMENT_MAIL=true
# VITE_ENFORCEMENT_MAIL_ENDPOINT=https://mail-gateway.example/blocklist
# VITE_ENFORCEMENT_CHAIN=true
# VITE_ENFORCEMENT_CHAIN_ENDPOINT=https://chain-analytics.example/reports
# VITE_ENFORCEMENT_ABUSE=true
# VITE_ENFORCEMENT_ABUSE_ENDPOINT=https://abuse.example/takedown

# AWS DynamoDB Configuration
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=replace-with-aws-access-key
AWS_SECRET_ACCESS_KEY=replace-with-aws-secret-key
DYNAMODB_TABLE_NAME=VIpertrace
# DYNAMODB_ENDPOINT=http://localhost:8000  # Uncomment for local DynamoDB
